# =============================================================
# FRONTEND (raiz do projeto) — variaveis de ambiente
# Copie para .env. Tudo aqui vai para o bundle: NAO coloque segredo.
# =============================================================

# URL do backend, SEM o /api no final — o codigo acrescenta sozinho
# (src/config/api.ts faz `${API_BASE_URL}/api`).
VITE_API_URL="http://localhost:3001"

# Supabase — usado apenas por partes legadas do front.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""

# Clerk — chave publica.
VITE_CLERK_PUBLISHABLE_KEY=""
