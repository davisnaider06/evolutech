# =============================================================
# BACKEND EVOLUTECH — variaveis de ambiente
# Copie para .env e preencha. O .env NAO vai para o git.
# =============================================================

# -------------------------------------------------------------
# OBRIGATORIAS — sem isso o sistema nao sobe ou sobe inseguro
# -------------------------------------------------------------

# Conexao com o Neon (PostgreSQL).
# ATENCAO: mantenha ?sslmode=require&pgbouncer=true no final,
# senao da o erro "cached plan must not change result type".
DATABASE_URL="postgres://USUARIO:SENHA@ep-XXXX.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Conexao direta (sem pooler). O Prisma usa nas migracoes.
# E a mesma URL do Neon, mas SEM o pgbouncer=true.
DIRECT_URL="postgres://USUARIO:SENHA@ep-XXXX.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Chave que assina os tokens de login (equipe e cliente final).
# Se mudar, todo mundo e deslogado. Tem fallback inseguro no codigo:
# sem essa variavel o sistema usa 'secret_fallback_dev', que e publico.
JWT_SECRET="uma-string-longa-e-aleatoria-aqui"

# Chave que criptografa as credenciais dos gateways de pagamento.
# >>> PRECISA SER A MESMA DO OUTRO PC <<<
# Se mudar, as credenciais de gateway ja salvas no banco ficam ilegiveis
# e cada empresa precisa reconectar o gateway na mao.
# Se nunca foi definida no outro PC, o sistema usou o JWT_SECRET como chave —
# nesse caso traga o JWT_SECRET antigo e deixe esta variavel vazia.
PAYMENT_KEYS_ENCRYPTION_SECRET=""

# -------------------------------------------------------------
# SERVIDOR
# -------------------------------------------------------------

PORT=3001
NODE_ENV=development

# Origens liberadas no CORS, separadas por virgula. '*' libera todas.
# Em producao aponte para o dominio do front.
CORS_ORIGIN="*"

# URL publica do front. Entra nos links de pagamento enviados ao cliente.
APP_PUBLIC_URL="http://localhost:8080"

# Validade dos tokens.
JWT_EXPIRES_IN="7d"
CUSTOMER_JWT_EXPIRES_IN="7d"

# Limite do corpo das requisicoes (upload de logo, importacao de produtos).
JSON_BODY_LIMIT="8mb"

# -------------------------------------------------------------
# WHATSAPP (Z-API) — opcional
# Sem isso, o envio de WhatsApp responde erro 500 com mensagem clara.
# Hoje e usado pela regua de cobranca.
# -------------------------------------------------------------

ZAPI_BASE_URL="https://api.z-api.io/instances"
ZAPI_INSTANCE_ID=""
ZAPI_INSTANCE_TOKEN=""
ZAPI_CLIENT_TOKEN=""

# -------------------------------------------------------------
# E-MAIL DE SUPORTE (Resend) — opcional
# Sem RESEND_API_KEY o ticket e criado normalmente, so nao dispara e-mail.
# -------------------------------------------------------------

RESEND_API_KEY=""
SUPPORT_NOTIFICATION_EMAIL=""
SUPPORT_FROM_EMAIL="Evolutech <onboarding@resend.dev>"

# -------------------------------------------------------------
# AUTOMACAO DE COBRANCA — opcional
# Job que roda sozinho disparando a regua de cobranca.
# Deixe false em desenvolvimento para nao mandar mensagem sem querer.
# -------------------------------------------------------------

COLLECTIONS_AUTOMATION_JOB_ENABLED=false
COLLECTIONS_AUTOMATION_JOB_MS=300000
COLLECTIONS_AUTOMATION_JOB_STARTUP_DELAY_MS=15000
COLLECTIONS_RETRY_DELAYS_MINUTES="30,120,360"

# -------------------------------------------------------------
# PERFORMANCE E DEBUG — todas opcionais, com default no codigo
# -------------------------------------------------------------

# Mantem a conexao do Neon viva (o Neon hiberna por inatividade).
DB_KEEPALIVE_ENABLED=true
DB_KEEPALIVE_MS=240000

# Caches em memoria (ms).
AUTH_ME_CACHE_TTL_MS=30000
MODULE_ACCESS_CACHE_TTL_MS=60000
COMPANY_PLAN_CACHE_TTL_MS=60000

# Logs. Ligue so quando estiver investigando algo.
REQUEST_LOG_ENABLED=false
PRISMA_LOG_QUERIES=false
AUTH_PERF_DEBUG=false
COMPANY_PERF_DEBUG=false
AUTH_SLOW_MS=300
COMPANY_SLOW_MS=300
AUTH_REQUIRE_DB_CHECK=false
